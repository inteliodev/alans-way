{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intelio.co/harness/profile.schema.json",
  "title": "Intelio profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "panels", "skills", "allowed_folders"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*$"
    },
    "panels": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*$" }
    },
    "skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/:-]*$" }
    },
    "allowed_folders": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "hermes_profile": {
      "type": "string",
      "pattern": "^$|^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "When set, the shell probes and launches with hermes -p <name>. Empty means hermes with no -p. Matches the Hermes profile id pattern."
    },
    "browsing_origins": {
      "type": "array",
      "description": "Optional per-bot browsing zone. Empty means no extra origin gate. When non-empty, agent navigation outside these origins is denied.",
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "yolo": { "type": "boolean", "const": false },
        "consequential": { "const": "ask" }
      }
    }
  }
}
